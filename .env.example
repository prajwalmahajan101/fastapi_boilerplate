# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Application ---
APP_ENVIRONMENT=dev

# --- Database ---
DB_HOST=ChangeMe       # "postgres" inside docker compose, "localhost" otherwise
DB_PORT=5432
DB_USER=ChangeMe
DB_PASSWORD=ChangeMe
DB_NAME=app

# --- Redis (JSON mapping of alias -> url) ---
# Aliases referenced by the resilience layer (cache / circuit breaker /
# rate limit) all default to "default". Add more aliases to isolate
# backends. If Redis is unreachable the resilience layer degrades to an
# in-memory fallback with a warning.
REDIS_URLS={"default":"redis://ChangeMe:6379/0"}

# --- Encryption ---
# Ordered list of Fernet keys for the EncryptedString column type and the
# FernetCipher helper (resilience-kit MultiFernet). The FIRST key is the
# primary (encrypts new writes); every listed key is tried on decrypt, so
# rotation is: prepend the new key, run `python -m
# src.management.rotate_encryption`, then drop the retired key. See
# docs/key-rotation.md. Required only if you use EncryptedString columns.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# RESILIENCE_CRYPTO__FIELD_ENCRYPTION_KEYS=["ChangeMe"]
# Legacy single-key form (deprecated in resilience-kit 0.2.0, still honoured
# for one minor cycle via legacy_env_alias — migrate to the list above):
# FIELD_ENCRYPTION_KEY=ChangeMe

# General-purpose app secret (token signing, etc.).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=ChangeMe

# --- AWS (optional — Secrets Manager / S3 / SES) ---
# When AWS_SECRET_NAME is set, that secret blob is the highest-priority
# settings source (above env vars and .env). Leave unset for local dev.
# AWS_REGION=ap-south-1
# AWS_SECRET_NAME=
# S3_DEFAULT_BUCKET=
# SES_DEFAULT_SENDER=

# --- CORS (off by default) ---
# Enable only if a browser needs to call this service. When enabled, list
# every allowed origin/method/header explicitly — the defaults are empty
# so a misconfigured deploy never accidentally exposes the API to "*".
#
# CORS_ENABLED=true
# CORS_ALLOW_ORIGINS=["https://app.example.com"]
# CORS_ALLOW_METHODS=["GET","POST","PATCH","DELETE"]
# CORS_ALLOW_HEADERS=["Content-Type","X-Request-ID"]
# CORS_ALLOW_CREDENTIALS=false

# --- OpenAPI docs (off by default) ---
# /docs (Swagger UI), /redoc, and /openapi.json. Off by default so
# production doesn't ship a public schema dump; enable in dev / staging.
OPENAPI_DOCS_ENABLED=true

# --- API audit log ---
# Backend for the fire-and-forget request/response audit log.
# "postgres" persists to the api_logs table; "noop" disables persistence.
# API_LOG_BACKEND=postgres
# Mask PII embedded inside captured bodies (PAN/Aadhaar/IFSC/… ). On by
# default; pattern set is india_fintech | global.
# API_LOG_REDACT_BODY_PII=true
# API_LOG_PII_PATTERN_SET=india_fintech

# --- Metrics / observability ---
# resilience-kit metrics sink: noop (default) | prometheus | otel | sentry.
# prometheus/otel/sentry need the matching kit extra installed.
# RESILIENCE_METRICS_SINK=prometheus
# Cap distinct tag-value combinations per metric (BoundedMetricsSink);
# drops labels past the budget so a stray high-cardinality label can't
# explode the backend.
# RESILIENCE_METRICS_CARDINALITY_BUDGET=1000
# Mount GET /metrics (Prometheus text exposition). Pair with
# RESILIENCE_METRICS_SINK=prometheus.
# METRICS_ENDPOINT_ENABLED=true
# Sample per-request duration into the metrics shim (off by default).
# METRICS_MIDDLEWARE_ENABLED=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
