# Production dependencies.
#
# Edit this file, then run `pip-compile requirements/base.in` (or let the
# pre-commit hook do it) to regenerate `requirements/base.txt`.

# Web framework
fastapi
uvicorn[standard]
# Transitive via fastapi/resilience-kit, pinned here to force the
# PYSEC-2026-248/249 fix (flagged by pip-audit; matches resilience-kit
# 0.2.0's lockfile bump).
starlette>=1.3.1

# Settings & validation
pydantic
# >=2.14.2 pulls the GHSA-4xgf-cpjx-pc3j fix (flagged by pip-audit; also
# bumped in resilience-kit 0.2.0's lockfile).
pydantic-settings>=2.14.2

# Database (async Postgres)
sqlalchemy[asyncio]
asyncpg

# Migrations
alembic

# Redis (async client lives in `redis.asyncio`)
redis

# AWS (Secrets Manager, S3, SES)
boto3

# Outbound HTTP (third-party APIs, used in src/core/utils/http_client.py)
aiohttp

# Field-level Fernet encryption
cryptography

# Background tasks — Celery (Redis broker via the redis dep above)
celery

# Auth — JWT (for the JWT auth provider) and Authlib (Google OAuth client)
# Both are imported lazily; deployments that disable a provider can pin
# these to a no-op by removing them from the project's actual requirements
# file. Kept here so the boilerplate-default `auth_enabled_providers`
# combinations all work out of the box.
PyJWT
authlib
itsdangerous  # Authlib StarletteOAuth2App needs SessionMiddleware

# Process-local circuit breaker tier — selected by
# `circuit_breaker_backend="pybreaker"`. Imported lazily so deployments
# that stay on the redis / memory tiers do not pay the cost.
pybreaker

# resilience-kit — the shared resilience kernel (M7/M8b migration).
# Replaces this repo's embedded `src/core/resilience/`, kit-owned
# middleware, ssrf guard, Fernet helper, HTTP client, and singleton-
# reset surface. v0.1.0 adds the helpers used by `src/core/middleware/
# request_id_bridge.py`, `src/core/exceptions/handlers.py::kit_error_handler`,
# `src/core/settings.py::legacy_env_alias()`, and the async test fixture.
# v0.2.0 adds the `[prometheus]` metrics sink (wired in `src/core/metrics.py`),
# the `india_fintech` audit redactor (`src/core/api_log/sanitizers.py`),
# MultiFernet field-key rotation (`src/management/rotate_encryption.py`), and
# `AsyncAPIClient` idempotency keys.
resilience-kit[fastapi,redis,http,crypto,audit-postgres,prometheus]==0.2.0
